# Kandev local
KANDEV_URL=http://127.0.0.1:38429
KANDEV_VERSION=CHANGEME  # pin real tag, never latest, in a persistent deployment

# tasks-assistant CLI. On the VPS the repo lives inside the /data volume.
# TASKS_ASSISTANT_HOME=/data/tasks-assistant
# TASKS_ASSISTANT_STATE_DIR=/data/tasks-assistant/runs

# Builder: the provider/model that implements the task.
# Must differ from the verifier pair. Read by the verifier for the distinctness gate.
BUILDER_PROVIDER=deepseek
BUILDER_MODEL=deepseek-chat

# Verifier: OpenAI-compatible endpoint. Use a different provider/model than the builder.
VERIFIER_PROVIDER=openrouter
VERIFIER_BASE_URL=https://openrouter.ai/api/v1
VERIFIER_MODEL=anthropic/claude-sonnet-4.5
VERIFIER_API_KEY=
