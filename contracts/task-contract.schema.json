{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acastillo.dev/schemas/task-contract.json",
  "title": "Contrato de tarea",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "title", "objective", "acceptance", "no_goals", "scope", "checks", "models", "budget"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "title": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["draft", "ready", "running", "blocked", "done"]
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "criterion", "evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "criterion": { "type": "string", "minLength": 1 },
          "evidence": { "enum": ["test", "diff", "artifact", "manual"] }
        }
      }
    },
    "no_goals": {
      "type": "array",
      "items": { "type": "string" }
    },
    "scope": {
      "type": "object",
      "required": ["paths_allow", "paths_deny"],
      "properties": {
        "repos": { "type": "array", "items": { "type": "string" } },
        "paths_allow": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "paths_deny": { "type": "array", "items": { "type": "string" } }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "run"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "run": { "type": "string", "minLength": 1 },
          "timeout_s": { "type": "number", "exclusiveMinimum": 0 },
          "required": { "type": "boolean" }
        }
      }
    },
    "models": {
      "type": "object",
      "required": ["builder", "verifier"],
      "properties": {
        "planner": { "$ref": "#/$defs/providerRef" },
        "builder": { "$ref": "#/$defs/providerRef" },
        "verifier": { "$ref": "#/$defs/providerRef" }
      }
    },
    "budget": {
      "type": "object",
      "required": ["max_attempts"],
      "properties": {
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 5 },
        "max_minutes": { "type": "number", "exclusiveMinimum": 0 },
        "max_usd": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "evidence_required": {
      "type": "array",
      "items": { "type": "string" }
    },
    "protected_paths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": { "type": "string" }
  },
  "$defs": {
    "providerRef": {
      "type": "object",
      "required": ["provider", "model"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 }
      }
    }
  }
}
